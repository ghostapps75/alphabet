# Alphabets App — API Keys Template
# Copy this file to .env and fill in your keys.
# Keys can also be entered at runtime via the Settings panel (⚙️ top right).

# ElevenLabs — for premium multi-language TTS voices
# Get yours at https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=

# OpenAI — for GPT-4o-mini quiz/example generation (optional)
# Get yours at https://platform.openai.com
VITE_OPENAI_API_KEY=

# Google Gemini — for Gemini Flash quiz/example generation (preferred)
# Get yours at https://aistudio.google.com
VITE_GEMINI_API_KEY=
